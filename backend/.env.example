# ==========================================
# 🔐 THE REPOSITORY CONFIGURATION CONTRACT 🔐
# ==========================================
# This file is the absolute source of truth for all environment variables 
# required by the backend, frontend, GitHub Actions, and Docker Compose.
# CI checks will fail if an app requests a variable missing from this file.
# 
# Instructions:
# 1. Run: cp .env.example .env
# 2. Fill in the placeholder values.
# 3. DO NOT COMMIT .env TO VERSION CONTROL.
# ==========================================

# --- [ 1. DOCKER & DATABASE CREDENTIALS ] ---
POSTGRES_DB=novocrypt
POSTGRES_USER=shield_user
# ⚠️ REPLACE BEFORE STARTING DOCKER (No default provided for security)
POSTGRES_PASSWORD=your-secure-postgres-password-here
DATABASE_URL=postgresql://shield_user:your-secure-postgres-password-here@localhost:5432/novocrypt
REDIS_URL=redis://localhost:6379

# --- [ 2. APPLICATION SECRETS ] ---
# ⚠️ ROTATE REGULARLY IN PRODUCTION
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_EXPIRY=7d
BCRYPT_SALT_ROUNDS=12

# --- [ 3. SERVER CONFIGURATION ] ---
NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# --- [ 4. THIRD-PARTY API KEYS ] ---
# AI Integration
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o-mini
CHATBOT_MAX_TOKENS=500

# Security APIs
TURNSTILE_SECRET_KEY=your-cloudflare-turnstile-secret-here
NEWSAPI_KEY=your-newsapi-key-here

# Email Delivery
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-smtp-app-password-here

# --- [ 5. BACKGROUND JOBS ] ---
CRON_THREAT_FETCH=0 */6 * * *
CRON_QDAY_UPDATE=0 9 * * 1

# --- [ 6. FRONTEND CONFIGURATION ] ---
VITE_API_BASE_URL=http://localhost:5000/api
VITE_WS_URL=ws://localhost:5000
VITE_APP_NAME=Novocrypt
VITE_QDAY_YEAR=2035
